# Copiar a .env y completar solo en el equipo local. No subir .env a Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
ADMIN_EMAIL=admin@example.com
# En producción se exigen 16 caracteres como mínimo y un valor que no sea de ejemplo.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Opcional: segundo factor administrativo (generar con npm run admin:totp).
ADMIN_TOTP_SECRET=
# Prototipo de video público en Cloudinary Free. La clave secreta nunca va al navegador.
PUBLIC_BASE_URL=https://kitsune-streaming.onrender.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PORT=4173
